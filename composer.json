{
    "name": "vaultic/sdk",
    "description": "Official PHP SDK for the Vaultic API",
    "type": "library",
    "license": "MIT",
    "keywords": ["vaultic", "api", "sdk", "prompts"],
    "authors": [
        {
            "name": "Vaultic",
            "email": "hello@vaultic.io"
        }
    ],
    "require": {
        "php": "^8.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "mockery/mockery": "^1.5",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "Vaultic\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vaultic\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse src"
    }
}

